# Ant Ling Plugin Integration Testing Environment Variables Example

# Your Ant Ling API Key (Obtain from https://chat.ant-ling.com/open)
ANT_LING_API_KEY=your_ant_ling_api_key_here

# API Base URL (Default is https://api.ant-ling.com/v1)
ANT_LING_API_BASE=https://api.ant-ling.com/v1

# Force bypass proxy for Ant Ling API
NO_PROXY=api.ant-ling.com,ant-ling.com
no_proxy=api.ant-ling.com,ant-ling.com
